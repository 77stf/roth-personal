# ROTH Personal OS — przykład zmiennych środowiskowych
# Skopiuj do .env.local i uzupełnij wartości

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Google OAuth + Sheets + Calendar ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_ID=
GOOGLE_REFRESH_TOKEN=

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ─── Obsidian Local REST API (tylko lokalnie, nie działa na Vercel) ────────────
OBSIDIAN_API_KEY=
OBSIDIAN_PORT=27124
OBSIDIAN_VAULT_PATH=

# ─── Zewnętrzne API ────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
WEATHER_LAT=
WEATHER_LON=

# ─── Auth ─────────────────────────────────────────────────────────────────────
ROTH_PASSCODE=
ROTH_SESSION_SECRET=

# ─── System ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://roth-personal.vercel.app
TZ=Europe/Warsaw
